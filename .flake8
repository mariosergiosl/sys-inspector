[flake8]
# Rationale for ignored Flake8 errors in this project:
#
# E501 (Line too long): Essential to ignore due to long embedded HTML templates and C code (eBPF) strings that should not be broken.
# W503 (Line break before binary operator): Ignored to ensure compatibility with the Black formatter, which prefers line breaks before operators.
# F541 (f-string without placeholders): Ignored to allow f-strings without variables, maintaining consistency for potential future code changes.
# E402 (Module level import not at top of file): Critical to ignore as sys.path.append('src') is executed before importing project modules.
# E741 (Ambiguous variable name): Explicitly allowed to permit variable names like 'l' (e.g., in sys_info.py loops) which were preserved by design.
# F824: Suppressed to prevent specific plugin false positives regarding undefined or duplicate names.
# E722 (Do not use bare 'except'): Added for Flask rapid error handling in web_controller.py.
# E701 multiple statements on one line (colon)
# F841 local variable 'e' is assigned to but never used
# E121 (Continuation line under-indented for hanging indent): part of pycodestyle's own default-ignore set; a purely cosmetic indentation preference that fights the project's aligned multi-line HTML/format strings.
# E226 (Missing whitespace around arithmetic operator): part of pycodestyle's default-ignore set; expressions like 'size/1024' inside f-strings read fine and breaking them adds no clarity.
# W504 (Line break after binary operator): mutually exclusive with W503, which is already ignored for Black compatibility; ignoring both is the standard resolution, since a codebase cannot satisfy the two at once.

max-line-length = 200
ignore = E501, W503, W504, F541, E402, E741, F824, E722, E701, F841, E121, E226
exclude = 
    .git,
    __pycache__,
    build,
    dist,
    venv,
    .venv,
    .github,
    logs

[pycodestyle]
max-line-length = 200

[mccabe]
max-complexity = 15
